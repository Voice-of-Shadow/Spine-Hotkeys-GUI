QDialog {
    background-color: palette(window);
}

QGroupBox {
    color: palette(window-text);
    border: 2px solid palette(mid);
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    background-color: palette(window);
}

QComboBox {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px 24px 4px 8px;
    color: palette(text);
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid palette(accent);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
}

QComboBox::down-arrow {
    image: url("./icon/down_arrow.png");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    color: palette(text);
    selection-color: palette(highlighted-text);
    background-color: palette(base);
    border: 1px solid palette(mid);
    selection-background-color: palette(highlight);
}

QPushButton {
    background-color: palette(button);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px 6px;
    color: palette(text);
    min-height: 20px;
}

QPushButton:hover {
    background-color: palette(light);
    border: 1px solid palette(accent);
}

QPushButton#btnCaptureSearch:focus {
    border: 1px solid palette(accent);
}

QPushButton:pressed {
    background-color: palette(midlight);
    border: 1px solid palette(accent);
}

QPushButton:disabled, QComboBox:disabled, QLineEdit:disabled {
    background-color: palette(window);
    border: 1px solid palette(mid);
    color: palette(placeholder-text);
}

QPushButton#btnQuoteMode[active="true"] {
    background-color: palette(highlight);
    border: 1px solid palette(accent);
    font-weight: bold;
}

QTableWidget {
    border: 1px solid palette(mid);
    background-color: palette(base);
    gridline-color: transparent;
    outline: none;
}

QTableWidget::item {
    padding: 4px;
    margin: 0px;
    border: none;
    background-color: transparent;
}

QTableWidget::item:selected {
    background-color: palette(highlight);
}

QTableWidget::item:disabled {
    padding: 0px;
    margin: 0px;
    background-color: palette(mid);
    min-height: 1px;
    max-height: 1px;
}

QScrollBar:vertical {
    background-color: palette(window);
    width: 12px;
    border: none;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: palette(dark);
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
    background-color: palette(shadow);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: palette(window);
}

QScrollBar:horizontal {
    background-color: palette(window);
    height: 12px;
    border: none;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: palette(dark);
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background-color: palette(shadow);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: palette(window);
}

QLineEdit {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 2px;
    padding: 4px;
    color: palette(text);
}

QLineEdit:focus {
    border: 1px solid palette(accent);
}

QLineEdit#searchHotkeys {
    min-height: 20px;
}

QLabel {
    color: palette(text);
    background-color: transparent;
}

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QDialogButtonBox QPushButton {
    min-width: 100px;
    min-height: 30px;
    margin: 0 16px;
    font-size: 14px;
    border-radius: 4px;
}

QDialogButtonBox QPushButton#btnOk, QDialogButtonBox QPushButton#btnSave {
    background-color: #1070e0;
    color: white;
    border: 1px solid #0e63c6;
}

QDialogButtonBox QPushButton#btnOk:hover, QDialogButtonBox QPushButton#btnSave:hover {
    background-color: #0f69d2;
    border: 1px solid #5899e5;
}

QDialogButtonBox QPushButton#btnOk:pressed, QDialogButtonBox QPushButton#btnSave:pressed {
    background-color: #0d58b0;
    border: 1px solid #5794dd;
}

QLabel#statusLabel {
    padding-top: 10px;
    padding-left: 0px;
    padding-right: 0px;
    padding-bottom: 10px;
    font-size: 14px;
}

InfoDialog QTextBrowser {
    color: palette(text);
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 10px;
}

QTextBrowser#aboutContent {
    background-color: transparent;
    border: none;
}

AlertDialog QLabel {
    font-size: 14px;
    padding: 20px;
}

QPushButton#btnYes, InfoDialog QPushButton#btnOk, QPushButton#btnConfirm {
    background-color: #1070e0;
    color: white;
    border: 1px solid #0e63c6;
    border-radius: 4px;
    padding: 5px 15px;
    min-width: 80px;
    min-height: 28px;
}

QPushButton#btnYes:hover, InfoDialog QPushButton#btnOk:hover, QPushButton#btnConfirm:hover {
    background-color: #0f69d2;
    border: 1px solid #5899e5;
}

QPushButton#btnYes:pressed, InfoDialog QPushButton#btnOk:pressed, QPushButton#btnConfirm:pressed {
    background-color: #0d58b0;
    border: 1px solid #5794dd;
}


QPushButton#btnCancel, QPushButton#btnNo {
    background-color: palette(button);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 5px 15px;
    min-width: 80px;
    min-height: 28px;
}

QPushButton#btnCancel:hover, QPushButton#btnNo:hover {
    background-color: palette(light);
    border: 1px solid palette(accent);
}

KeyInputDialog QLabel#promptLabel {
    font-size: 14px;
    color: palette(link);
}
